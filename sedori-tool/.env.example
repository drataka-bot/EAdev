# Keepa API キー (https://keepa.com/#!api)
KEEPA_API_KEY=
KEEPA_DOMAIN=5

# トークン節約モード設定 (Basic プラン: 5トークン/分 を想定)
# offers=0 にすると 1 ASIN あたり 1 トークン (最安)
# offers=20 にすると 1 ASIN あたり約 6 トークン (FBA出品者数の内訳が取れる)
KEEPA_OFFERS=0
# 1 リクエストあたりの ASIN 数 (Keepa API 上限は 100)
KEEPA_BATCH_SIZE=100
# バッチ間 sleep 秒
KEEPA_BATCH_SLEEP_SEC=1.2

# 楽天市場 商品検索 API (https://webservice.rakuten.co.jp/)
RAKUTEN_APP_ID=

# Yahoo!ショッピング 商品検索 API (https://e.developer.yahoo.co.jp/)
YAHOO_CLIENT_ID=

# ビックカメラ本店 + ヨドバシカメラ本店のスクレイピングを許可するか
# true / false。デフォルト false (公式 API のみで運用)
# 注意: スクレイピングは ToS / 安定性 / IP BAN リスクあり、自己責任で。
ENABLE_SCRAPING=false

# 在庫アラート (ウォッチリスト) 用
# Discord Webhook URL: 「サーバー設定 → 連携サービス → ウェブフック」で発行
DISCORD_WEBHOOK_URL=
# 監視間隔 (秒)。デフォルト 900 = 15 分
WATCHLIST_INTERVAL_SEC=900
# SQLite ファイルの保存先 (相対パスは backend カレントから)
WATCHLIST_DB_PATH=watchlist.db

BACKEND_CORS_ORIGINS=http://localhost:5173

# 補足:
# - 上記を空のまま起動して、UI の「設定」画面からキーを入力する運用も可能。
# - UI で入力したキーは .env より優先されます。
# - "your_xxxx" のようなプレースホルダ値は無視されます。
